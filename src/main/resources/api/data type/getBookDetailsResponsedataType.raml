#%RAML 1.0 DataType
type: object
properties:
  books:
    type: array
    items:
      type: object
      properties:
       id:
        type: string
        required: true
        minLength: 4
        maxLength: 12
       title:
        type: string
        required: true
        minLength: 5
        maxLength: 15
       author:
        type: string
        minLength: 6
        maxLength: 15
       price:
        type: number
        required: true
    


    


      
     